# Public HTTP API. Development-only defaults. Do not expose without TLS.
API_HOST=127.0.0.1
API_PORT=3001
ALLOWED_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:1420,http://localhost:5173,http://localhost:1420
# Mandatory secret for server registration. Generate a strong random string.
RIVEX_REGISTRY_TOKEN=change-me-to-a-long-random-secret
